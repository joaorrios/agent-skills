#!/usr/bin/env python3
"""uat-lock: run one UAT at a time on this machine, in arrival order.

Usage:
  uat-lock run -- <command...>   wait for your turn, then run the command
  uat-lock status                show the running UAT, the queue, and the load

One UAT runs at a time: the holder keeps a kernel lock (flock) on run.lock, and
the kernel drops it when the holder's process dies. Waiters queue as numbered
tickets, each also held with flock, so a dead waiter leaves the queue on its
own. Only the head of the queue may take the run lock, and it starts only when
the 1-minute load average is below the limit (default 8).

Environment: UAT_LOCK_DIR (default ~/.local/state/uat-lock),
UAT_LOCK_MAX_LOAD (default 8), UAT_LOCK_POLL (seconds, default 2).
"""
import fcntl
import os
import signal
import subprocess
import sys
import time

LOCK_DIR = os.path.expanduser(os.environ.get("UAT_LOCK_DIR", "~/.local/state/uat-lock"))
MAX_LOAD = float(os.environ.get("UAT_LOCK_MAX_LOAD", "8"))
POLL = float(os.environ.get("UAT_LOCK_POLL", "2"))
TICKETS = os.path.join(LOCK_DIR, "tickets")
GUARD = os.path.join(LOCK_DIR, "queue.lock")
COUNTER = os.path.join(LOCK_DIR, "next")
RUN_LOCK = os.path.join(LOCK_DIR, "run.lock")


def say(msg):
    sys.stderr.write("uat-lock: %s\n" % msg)
    sys.stderr.flush()


def load1():
    return os.getloadavg()[0]


class Guard(object):
    """Exclusive flock on queue.lock around every queue read or write."""

    def __enter__(self):
        self.fd = os.open(GUARD, os.O_RDWR | os.O_CREAT, 0o644)
        fcntl.flock(self.fd, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        os.close(self.fd)


def held_by_someone(path):
    """True when another open file holds a flock on path."""
    try:
        fd = os.open(path, os.O_RDONLY)
    except OSError:
        return False
    try:
        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        return False
    except OSError:
        return True
    finally:
        os.close(fd)


def read_info(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def live_tickets(mine=None):
    """Sorted live ticket names; removes tickets whose owner died. Call under Guard."""
    names = sorted(n for n in os.listdir(TICKETS) if n.endswith(".lock"))
    live = []
    for n in names:
        p = os.path.join(TICKETS, n)
        if n == mine or held_by_someone(p):
            live.append(n)
        else:
            try:
                os.unlink(p)
            except OSError:
                pass
    return live


def setup():
    os.makedirs(TICKETS, exist_ok=True)


def take_ticket(cmd):
    with Guard():
        try:
            with open(COUNTER) as f:
                seq = int(f.read().strip() or "0")
        except (OSError, ValueError):
            seq = 0
        with open(COUNTER, "w") as f:
            f.write(str(seq + 1))
        name = "%012d.lock" % seq
        fd = os.open(os.path.join(TICKETS, name), os.O_RDWR | os.O_CREAT | os.O_TRUNC, 0o644)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        os.write(fd, ("pid=%d since=%s cmd=%s\n" % (
            os.getpid(), time.strftime("%Y-%m-%d %H:%M:%S"), " ".join(cmd))).encode())
    return seq, name, fd


def drop_ticket(name, fd):
    with Guard():
        try:
            os.unlink(os.path.join(TICKETS, name))
        except OSError:
            pass
    os.close(fd)


def cmd_run(cmd):
    if not cmd:
        say("usage: uat-lock run -- <command...>")
        return 2
    setup()
    seq, name, tfd = take_ticket(cmd)
    run_fd = None
    child = {"p": None}

    def on_signal(signum, frame):
        p = child["p"]
        if p is not None and p.poll() is None:
            p.send_signal(signum)
            return
        raise SystemExit(128 + signum)

    for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, on_signal)

    last_status = None
    last_print = 0.0
    try:
        while True:
            with Guard():
                live = live_tickets(mine=name)
            pos = live.index(name)
            load = load1()
            if pos == 0:
                if run_fd is None:
                    fd = os.open(RUN_LOCK, os.O_RDWR | os.O_CREAT, 0o644)
                    try:
                        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                        run_fd = fd
                    except OSError:
                        os.close(fd)
                if run_fd is not None and load < MAX_LOAD:
                    break
                if run_fd is None:
                    status = "ticket %d: next in line, waiting for the running UAT (%s) to finish; load %.2f" % (
                        seq, " ".join(read_info(RUN_LOCK + ".info").split()[:2]) or "starting", load)
                else:
                    status = "ticket %d: next in line, waiting for load %.2f to drop below %g" % (seq, load, MAX_LOAD)
            else:
                status = "ticket %d: position %d in queue (%d ahead); load %.2f" % (seq, pos + 1, pos, load)
            now = time.time()
            key = status.split(";")[0]
            if key != last_status or now - last_print >= 30:
                say(status)
                last_status, last_print = key, now
            time.sleep(POLL)

        info = "ticket=%d pid=%d since=%s cmd=%s" % (
            seq, os.getpid(), time.strftime("%Y-%m-%d %H:%M:%S"), " ".join(cmd))
        with open(RUN_LOCK + ".info", "w") as f:
            f.write(info + "\n")
        drop_ticket(name, tfd)
        tfd = None
        say("ticket %d: your turn (load %.2f); running: %s" % (seq, load1(), " ".join(cmd)))
        try:
            child["p"] = subprocess.Popen(cmd)
        except OSError as e:
            say("cannot run %s: %s" % (cmd[0], e))
            return 127
        while True:
            try:
                rc = child["p"].wait()
                break
            except InterruptedError:
                continue
        say("ticket %d: done, exit code %d; lock released" % (seq, rc if rc >= 0 else 128 - rc))
        return rc if rc >= 0 else 128 - rc
    finally:
        if tfd is not None:
            try:
                drop_ticket(name, tfd)
            except OSError:
                pass
        if run_fd is not None:
            try:
                os.unlink(RUN_LOCK + ".info")
            except OSError:
                pass
            os.close(run_fd)


def cmd_status():
    setup()
    load = load1()
    print("load (1 min): %.2f, limit %g" % (load, MAX_LOAD))
    if os.path.exists(RUN_LOCK) and held_by_someone(RUN_LOCK):
        print("running: %s" % (read_info(RUN_LOCK + ".info") or "a UAT (starting or waiting for load)"))
    else:
        print("running: none")
    with Guard():
        live = live_tickets()
        rows = [(n, read_info(os.path.join(TICKETS, n))) for n in live]
    if not rows:
        print("queue: empty")
    for i, (n, info) in enumerate(rows):
        print("queue %d: ticket %d %s" % (i + 1, int(n.split(".")[0]), info))
    return 0


def main(argv):
    if len(argv) >= 1 and argv[0] == "status":
        return cmd_status()
    if len(argv) >= 1 and argv[0] == "run":
        rest = argv[1:]
        if rest and rest[0] == "--":
            rest = rest[1:]
        return cmd_run(rest)
    sys.stdout.write(__doc__)
    return 0 if argv[:1] in (["-h"], ["--help"]) else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
