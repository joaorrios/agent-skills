#!/usr/bin/env python3
"""uat-lock: one queue for every local UAT and Electron test run on this machine.

Usage:
  uat-lock run [--label <text>] -- <command...>
      Wait for your turn, run the command, release when it exits.
  uat-lock hold [--label <text>]
      Wait for your turn, print READY on stdout, and hold the turn until stdin
      reaches EOF or the process gets SIGTERM/SIGINT/SIGHUP. For harnesses
      (Node, Playwright) that hold the turn for an exact Electron session:
      spawn it with a stdin pipe, wait for READY, close stdin (or kill it) when
      done. A crash or SIGKILL releases the turn too, and stdin EOF while still
      waiting leaves the queue without printing READY (exit code 1).
  uat-lock status
      Show the load, the CI runner, the running holder, Electron test
      processes (in-queue or OUT-OF-QUEUE), and the queue.

One holder at a time: the holder (and, for run, its command) keeps a kernel
lock (flock) on run.lock, which the kernel drops when they die. Waiters queue
as numbered tickets in tickets/, each held with flock, so a dead waiter leaves
the queue on its own. Only the head of the queue takes run.lock, and it starts
once every gate is open:
  - the 1-minute load average is below UAT_LOCK_MAX_LOAD (default 8);
  - no GitHub Actions Runner.Worker job is running (skipped inside a CI job,
    with GITHUB_ACTIONS=true, or with UAT_LOCK_IGNORE_RUNNER=1);
  - no Electron test process runs outside the holder's process tree (skipped
    with UAT_LOCK_IGNORE_ELECTRON=1).
When the process list cannot be read, the CI runner and Electron gates stay
closed, status reports them as unknown (exit code 1), and a nested call that
cannot verify its holder exits with code 1.

Re-entrancy: the command of `run` gets UAT_LOCK_HELD=1 and
UAT_LOCK_HOLDER_PID=<holder pid>; `hold` prints that pid on stderr for its
caller to export. A nested run or hold that sees these variables passes
through without queueing once it verifies that run.lock is held by that pid
and that the pid (or the process that started `hold`) is its ancestor.

Environment: UAT_LOCK_DIR (default ~/.local/state/uat-lock), UAT_LOCK_MAX_LOAD,
UAT_LOCK_POLL (seconds, default 2). Test hooks: UAT_LOCK_PS_FILE (a file in
`ps -axo pid=,ppid=,etime=,command=` format used instead of ps) and
UAT_LOCK_LOAD_FILE (a file holding the load average), both re-read each poll;
UAT_LOCK_TEST_INFO_GATE (run holds its post-spawn run.lock.info update until
this file exists).
"""
import fcntl
import os
import re
import select
import signal
import subprocess
import sys
import time

LOCK_DIR = os.path.expanduser(os.environ.get("UAT_LOCK_DIR", "~/.local/state/uat-lock"))
MAX_LOAD = float(os.environ.get("UAT_LOCK_MAX_LOAD", "8"))
POLL = float(os.environ.get("UAT_LOCK_POLL", "2"))
TICKETS = os.path.join(LOCK_DIR, "tickets")
GUARD = os.path.join(LOCK_DIR, "queue.lock")
COUNTER = os.path.join(LOCK_DIR, "next")
RUN_LOCK = os.path.join(LOCK_DIR, "run.lock")
INFO = RUN_LOCK + ".info"

# Launch wrappers skipped when naming who started an Electron process.
WRAPPERS = {"sh", "bash", "zsh", "dash", "fish", "env", "node", "npm", "npx", "pnpm",
            "yarn", "bun", "electron", "Electron", "timeout", "caffeinate", "xargs",
            "tee", "script", "nohup"}


def say(msg):
    sys.stderr.write("uat-lock: %s\n" % msg)
    sys.stderr.flush()


def now():
    return time.strftime("%Y-%m-%d %H:%M:%S")


def load1():
    path = os.environ.get("UAT_LOCK_LOAD_FILE")
    if path:
        try:
            with open(path) as f:
                return float(f.read().strip())
        except (OSError, ValueError):
            pass
    return os.getloadavg()[0]


# ---------------------------------------------------------------- processes

# Executables are classified by argv[0], read apart from the flattened command
# line (ps comm on macOS, /proc/<pid>/cmdline on Linux), so spaces in a path
# and paths inside option values are never confused.
KNOWN_EXES = [
    ("electron", re.compile(r"(?:^|/)node_modules/.*/Electron\.app/Contents/MacOS/Electron$")),
    ("electron", re.compile(r"(?:^|/)node_modules/(?:.*/)?electron/dist/electron$")),
    ("runner", re.compile(r"(?:^|/)Runner\.Worker$")),
]


class InspectError(Exception):
    """The process list could not be read."""


class Proc(object):
    __slots__ = ("pid", "ppid", "etime", "cmd", "kind", "exe")

    def __init__(self, pid, ppid, etime, cmd, exe=None):
        self.pid, self.ppid, self.etime, self.cmd = pid, ppid, etime, cmd
        if not exe or not cmd.startswith(exe):
            exe = cmd.split(" ", 1)[0]
        self.exe, self.kind = exe, None
        for kind, rx in KNOWN_EXES:
            if rx.search(exe):
                self.kind = kind
                break

    @property
    def base(self):
        return os.path.basename(self.exe)

    @property
    def args(self):
        return self.cmd[len(self.exe):]


def argv0_map(pids):
    """{pid: argv[0]} read apart from the command line; InspectError on failure.

    A pid missing from the map (it exited between the two reads) falls back to
    the first word of its command line.
    """
    out = {}
    if sys.platform.startswith("linux"):
        for pid in pids:
            try:
                with open("/proc/%d/cmdline" % pid, "rb") as f:
                    argv0 = f.read().split(b"\0", 1)[0]
            except OSError:
                continue
            out[pid] = argv0.decode("utf-8", "replace")
    else:
        try:
            text = subprocess.check_output(["ps", "-axww", "-o", "pid=,comm="],
                                           universal_newlines=True, stderr=subprocess.DEVNULL)
        except (OSError, subprocess.CalledProcessError) as e:
            raise InspectError("executable lookup (ps comm) failed: %s" % e)
        for line in text.splitlines():
            parts = line.strip().split(" ", 1)
            if len(parts) == 2 and parts[0].isdigit():
                out[int(parts[0])] = parts[1].strip()
    if os.getpid() not in out:
        raise InspectError("executable lookup returned no usable list")
    return out


def process_table():
    """{pid: Proc} from UAT_LOCK_PS_FILE when set, else from ps; InspectError on failure.

    UAT_LOCK_PS_FILE lines are "pid ppid etime command"; a line written as
    "pid ppid etime argv0<TAB>args" gives argv[0] (spaces allowed) explicitly.
    """
    path = os.environ.get("UAT_LOCK_PS_FILE")
    if path:
        try:
            with open(path) as f:
                text = f.read()
        except OSError as e:
            raise InspectError("cannot read UAT_LOCK_PS_FILE: %s" % e)
    else:
        try:
            text = subprocess.check_output(
                ["ps", "-axww", "-o", "pid=,ppid=,etime=,command="],
                universal_newlines=True, stderr=subprocess.DEVNULL)
        except (OSError, subprocess.CalledProcessError) as e:
            raise InspectError("ps failed: %s" % e)
    rows = []
    for line in text.splitlines():
        parts = line.strip().split(None, 3)
        if len(parts) < 4:
            continue
        try:
            pid, ppid = int(parts[0]), int(parts[1])
        except ValueError:
            continue
        rows.append((pid, ppid, parts[2], parts[3]))
    argv0 = {} if path else argv0_map([r[0] for r in rows])
    table = {}
    for pid, ppid, etime, cmd in rows:
        exe = argv0.get(pid)
        if path and "\t" in cmd:
            exe, rest = cmd.split("\t", 1)
            cmd = exe + (" " + rest if rest else "")
        table[pid] = Proc(pid, ppid, etime, cmd, exe)
    if not path and os.getpid() not in table:
        raise InspectError("ps returned no usable process list")
    return table


def ancestors(pid, table, include_self=True):
    """pid's ancestor chain, nearest first."""
    out, seen = [], set()
    cur = pid if include_self else (table[pid].ppid if pid in table else None)
    while cur and cur not in seen and cur in table:
        seen.add(cur)
        out.append(cur)
        cur = table[cur].ppid
    return out


def is_runner_worker(p):
    return p.kind == "runner"


def inside_runner(table):
    if os.environ.get("GITHUB_ACTIONS") == "true":
        return True
    return any(is_runner_worker(table[a]) for a in ancestors(os.getpid(), table))


def is_electron_test(p):
    """An Electron main process started for a test or QA, never a desktop app."""
    if p.cmd.startswith("/Applications/") or "--type=" in p.cmd:
        return False
    if p.kind == "electron":
        return True
    if p.base in ("Electron", "electron", "node"):
        return "out/main/index.js" in p.args or "electron/loader.js" in p.args
    return False


def electron_roots(table):
    """Electron test processes, without the ones started by another of them."""
    hits = {pid for pid, p in table.items() if is_electron_test(p)}
    return [table[pid] for pid in sorted(hits)
            if not any(a in hits for a in ancestors(pid, table, include_self=False))]


def path_before(text, marker):
    """The absolute path in text that ends right before marker, spaces kept."""
    i = text.find(marker)
    if i < 0:
        return None
    head = text[:i]
    j = head.rfind(" /")
    if j >= 0:
        return head[j + 1:]
    return head if head.startswith("/") else None


def worktree_of(p):
    if "/node_modules/" in p.exe:
        return p.exe.split("/node_modules/", 1)[0] or "?"
    for marker in ("/out/main/index.js", "/node_modules/"):
        found = path_before(p.args, marker)
        if found:
            return found
    return "." if "out/main/index.js" in p.args else "?"


def short(cmd, width=80):
    cmd = cmd.replace(os.path.expanduser("~"), "~")
    return cmd if len(cmd) <= width else cmd[:width - 3] + "..."


def launcher_of(p, table):
    for a in ancestors(p.pid, table, include_self=False):
        q = table[a]
        if q.pid == 1:
            return None
        if q.base not in WRAPPERS and not is_electron_test(q):
            return q
    return None


# ------------------------------------------------------------------- holder

def parse_info(text):
    head = text.split(" since=", 1)[0]
    return {k: int(v) for k, v in re.findall(r"\b(ticket|pid|owner|child)=(\d+)", head)}


def read_info(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def held_by_someone(path):
    """True when another open file holds a flock on path."""
    try:
        fd = os.open(path, os.O_RDONLY)
    except OSError:
        return False
    try:
        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        return False
    except OSError:
        return True
    finally:
        os.close(fd)


def holder_pids():
    """Roots of the current holder's process tree, or an empty set."""
    if not held_by_someone(RUN_LOCK):
        return set()
    return {v for k, v in parse_info(read_info(INFO)).items() if k != "ticket" and v > 0}


def inherited_turn():
    """True when an ancestor verifiably holds run.lock for this process tree."""
    if os.environ.get("UAT_LOCK_HELD") != "1":
        return False
    try:
        hp = int(os.environ.get("UAT_LOCK_HOLDER_PID", ""))
    except ValueError:
        hp = 0
    info = parse_info(read_info(INFO))
    # The command (child) keeps run.lock after its wrapper dies, so it is a
    # valid root too; the holder pid and the held lock are still checked.
    roots = {hp, info.get("owner", 0), info.get("child", 0)} - {0}
    try:
        chain = set(ancestors(os.getpid(), process_table()))
    except InspectError as e:
        # Queueing could wait behind our own ancestor forever; stop instead.
        say("UAT_LOCK_HELD is set but the holder cannot be verified (%s); exiting" % e)
        raise SystemExit(1)
    if hp and info.get("pid") == hp and held_by_someone(RUN_LOCK) and roots & chain:
        say("holder %d holds the turn for this process tree; passing through" % hp)
        return True
    say("UAT_LOCK_HELD is set but pid %s does not hold run.lock as an ancestor; queueing"
        % (hp or "?"))
    os.environ.pop("UAT_LOCK_HELD", None)
    os.environ.pop("UAT_LOCK_HOLDER_PID", None)
    return False


# -------------------------------------------------------------------- queue

class Guard(object):
    """Exclusive flock on queue.lock around every queue read or write."""

    def __enter__(self):
        self.fd = os.open(GUARD, os.O_RDWR | os.O_CREAT, 0o644)
        fcntl.flock(self.fd, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        os.close(self.fd)


def live_tickets(mine=None):
    """Sorted live ticket names; removes tickets whose owner died. Call under Guard."""
    names = sorted(n for n in os.listdir(TICKETS) if n.endswith(".lock"))
    live = []
    for n in names:
        p = os.path.join(TICKETS, n)
        if n == mine or held_by_someone(p):
            live.append(n)
        else:
            try:
                os.unlink(p)
            except OSError:
                pass
    return live


def setup():
    os.makedirs(TICKETS, exist_ok=True)


def take_ticket(what):
    with Guard():
        try:
            with open(COUNTER) as f:
                seq = int(f.read().strip() or "0")
        except (OSError, ValueError):
            seq = 0
        with open(COUNTER, "w") as f:
            f.write(str(seq + 1))
        name = "%012d.lock" % seq
        fd = os.open(os.path.join(TICKETS, name), os.O_RDWR | os.O_CREAT | os.O_TRUNC, 0o644)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        os.write(fd, ("pid=%d since=%s %s\n" % (os.getpid(), now(), what)).encode())
    return seq, name, fd


def drop_ticket(name, fd):
    with Guard():
        try:
            os.unlink(os.path.join(TICKETS, name))
        except OSError:
            pass
    os.close(fd)


def gate_reasons(ignore_runner, ignore_electron):
    """(load, [(key, text)]) for every closed gate, the holder being this process."""
    load = load1()
    reasons = []
    if load >= MAX_LOAD:
        reasons.append(("load", "load %.2f to drop below %g" % (load, MAX_LOAD)))
    if ignore_runner and ignore_electron:
        return load, reasons
    try:
        table = process_table()
    except InspectError as e:
        reasons.append(("inspect", "process inspection to work (%s); the CI runner and Electron "
                        "gates stay closed until it does" % e))
        return load, reasons
    if not ignore_runner:
        for p in sorted(table.values(), key=lambda p: p.pid):
            if is_runner_worker(p):
                reasons.append(("runner %d" % p.pid, "CI job to finish (Runner.Worker pid %d, running %s)"
                                % (p.pid, p.etime)))
    if not ignore_electron:
        mine = os.getpid()
        for p in electron_roots(table):
            if mine not in ancestors(p.pid, table):
                reasons.append(("electron %d" % p.pid,
                                "out-of-queue Electron pid %d (worktree %s, running %s) to exit"
                                % (p.pid, worktree_of(p), p.etime)))
    return load, reasons


class Cancelled(Exception):
    """stdin reached EOF before the turn started."""


class Turn(object):
    """Queue, wait for run.lock and the gates, then hold run.lock until released."""

    def __init__(self, mode, label, what):
        self.mode, self.label, self.what = mode, label, what
        self.watch_stdin = mode == "hold"
        self.seq = self.name = self.tfd = self.run_fd = None
        self.owner = os.getppid() if mode == "hold" else 0

    def info(self, child=0):
        return "ticket=%d pid=%d owner=%d child=%d mode=%s since=%s %s" % (
            self.seq, os.getpid(), self.owner, child, self.mode, self.since, self.what)

    def write_info(self, child=0):
        # Publish atomically: a nested call may read the file at any moment.
        tmp = "%s.%d.tmp" % (INFO, os.getpid())
        with open(tmp, "w") as f:
            f.write(self.info(child) + "\n")
        gate = os.environ.get("UAT_LOCK_TEST_INFO_GATE")
        if gate and child:
            # Test hook: hold the post-spawn update until the command touches gate.
            end = time.time() + 60
            while not os.path.exists(gate) and time.time() < end:
                time.sleep(0.02)
        os.replace(tmp, INFO)

    def acquire(self):
        setup()
        self.since = now()
        self.seq, self.name, self.tfd = take_ticket(self.what)
        try:
            in_ci = inside_runner(process_table())
        except InspectError:
            in_ci = os.environ.get("GITHUB_ACTIONS") == "true"
        ignore_runner = os.environ.get("UAT_LOCK_IGNORE_RUNNER") == "1" or in_ci
        ignore_electron = os.environ.get("UAT_LOCK_IGNORE_ELECTRON") == "1"
        last_key, last_print = None, 0.0
        seq = self.seq
        while True:
            with Guard():
                live = live_tickets(mine=self.name)
            self.check_eof()
            pos = live.index(self.name)
            if pos > 0:
                key = ("queue", pos)
                status = "ticket %d: position %d in queue (%d ahead); load %.2f" % (seq, pos + 1, pos, load1())
            else:
                if self.run_fd is None:
                    fd = os.open(RUN_LOCK, os.O_RDWR | os.O_CREAT, 0o644)
                    try:
                        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                        self.run_fd = fd
                        self.write_info()
                    except OSError:
                        os.close(fd)
                if self.run_fd is None:
                    key = ("running",)
                    status = "ticket %d: next in line, waiting for the running holder (%s) to finish" % (
                        seq, " ".join(read_info(INFO).split()[:2]) or "starting")
                else:
                    load, reasons = gate_reasons(ignore_runner, ignore_electron)
                    self.check_eof()
                    if not reasons:
                        break
                    key = tuple(k for k, _ in reasons)
                    status = "ticket %d: next in line, waiting for %s" % (
                        seq, "; ".join(t for _, t in reasons))
            t = time.time()
            if key != last_key or t - last_print >= 30:
                say(status)
                last_key, last_print = key, t
            self.pause()
        drop_ticket(self.name, self.tfd)
        self.tfd = None
        self.write_info()
        self.check_eof()

    def check_eof(self):
        """For hold, raise Cancelled when stdin already reached EOF; never blocks."""
        if not self.watch_stdin:
            return
        try:
            for _ in range(64):
                ready, _, _ = select.select([0], [], [], 0)
                if not ready:
                    return
                if not os.read(0, 65536):
                    raise Cancelled()
        except (OSError, ValueError):
            raise Cancelled()

    def pause(self):
        """Sleep one poll; for hold, raise Cancelled as soon as stdin reaches EOF."""
        if not self.watch_stdin:
            time.sleep(POLL)
            return
        end = time.time() + POLL
        while True:
            left = end - time.time()
            if left <= 0:
                return
            try:
                ready, _, _ = select.select([0], [], [], left)
                if ready and not os.read(0, 65536):
                    raise Cancelled()
            except (OSError, ValueError):
                raise Cancelled()
            if ready:
                time.sleep(min(left, 0.05))

    def release(self):
        try:
            os.unlink("%s.%d.tmp" % (INFO, os.getpid()))
        except OSError:
            pass
        if self.tfd is not None:
            try:
                drop_ticket(self.name, self.tfd)
            except OSError:
                pass
            self.tfd = None
        if self.run_fd is not None:
            try:
                os.unlink(INFO)
            except OSError:
                pass
            os.close(self.run_fd)
            self.run_fd = None


def install_signals(child):
    def on_signal(signum, frame):
        p = child.get("p")
        if p is not None and p.poll() is None:
            p.send_signal(signum)
            return
        raise SystemExit(128 + signum)

    for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, on_signal)


def cmd_run(label, cmd):
    if not cmd:
        say("usage: uat-lock run [--label <text>] -- <command...>")
        return 2
    if inherited_turn():
        try:
            os.execvp(cmd[0], cmd)
        except OSError as e:
            say("cannot run %s: %s" % (cmd[0], e))
            return 127
    child = {}
    install_signals(child)
    what = ("label=%s " % label if label else "") + "cmd=" + " ".join(cmd)
    turn = Turn("run", label, what)
    try:
        turn.acquire()
        say("ticket %d: your turn (load %.2f); running: %s" % (turn.seq, load1(), " ".join(cmd)))
        env = dict(os.environ, UAT_LOCK_HELD="1", UAT_LOCK_HOLDER_PID=str(os.getpid()))
        try:
            # The child inherits the run lock, so killing only this wrapper
            # cannot admit the next holder while the command still runs.
            child["p"] = subprocess.Popen(cmd, pass_fds=(turn.run_fd,), env=env)
        except OSError as e:
            say("cannot run %s: %s" % (cmd[0], e))
            return 127
        turn.write_info(child["p"].pid)
        while True:
            try:
                rc = child["p"].wait()
                break
            except InterruptedError:
                continue
        rc = rc if rc >= 0 else 128 - rc
        say("ticket %d: done, exit code %d; lock released" % (turn.seq, rc))
        return rc
    finally:
        turn.release()


def wait_for_release():
    print("READY", flush=True)
    while True:
        try:
            if not os.read(0, 65536):
                return
        except OSError:
            return


def cmd_hold(label):
    if inherited_turn():
        wait_for_release()
        return 0
    install_signals({})
    what = "label=%s" % (label or "hold")
    turn = Turn("hold", label, what)
    try:
        turn.acquire()
        say("ticket %d: your turn (load %.2f); holding until stdin closes or SIGTERM; "
            "export UAT_LOCK_HELD=1 UAT_LOCK_HOLDER_PID=%d to nested uat-lock calls"
            % (turn.seq, load1(), os.getpid()))
        turn.check_eof()
        wait_for_release()
        say("ticket %d: released" % turn.seq)
        return 0
    except Cancelled:
        say("ticket %d: stdin closed before the turn started; left the queue" % turn.seq)
        return 1
    finally:
        turn.release()


def cmd_status():
    setup()
    try:
        table, failure = process_table(), None
    except InspectError as e:
        table, failure = {}, "unknown (process inspection unavailable: %s)" % e
    print("load (1 min): %.2f, limit %g" % (load1(), MAX_LOAD))

    workers = sorted((p for p in table.values() if is_runner_worker(p)), key=lambda p: p.pid)
    if failure:
        print("ci runner: %s" % failure)
    elif not workers:
        print("ci runner: idle")
    for p in workers:
        print("ci runner: active Runner.Worker pid %d, elapsed %s" % (p.pid, p.etime))

    if held_by_someone(RUN_LOCK):
        print("running: %s" % (read_info(INFO) or "a holder (starting)"))
    else:
        print("running: none")

    roots = holder_pids()
    procs = electron_roots(table)
    if failure:
        print("electron: %s" % failure)
    elif not procs:
        print("electron: none")
    for p in procs:
        where = "in-queue" if roots & set(ancestors(p.pid, table)) else "OUT-OF-QUEUE"
        parent = table.get(p.ppid)
        launcher = launcher_of(p, table)
        print("electron: pid %d, elapsed %s, %s, worktree %s, parent %s, launcher %s" % (
            p.pid, p.etime, where, worktree_of(p).replace(os.path.expanduser("~"), "~"),
            "%d %s" % (parent.pid, short(parent.cmd, 60)) if parent else str(p.ppid),
            "%d %s" % (launcher.pid, short(launcher.cmd, 80)) if launcher else "none (orphaned)"))

    with Guard():
        live = live_tickets()
        rows = [(n, read_info(os.path.join(TICKETS, n))) for n in live]
    if not rows:
        print("queue: empty")
    for i, (n, info) in enumerate(rows):
        print("queue %d: ticket %d %s" % (i + 1, int(n.split(".")[0]), info))
    return 1 if failure else 0


def parse_label(args):
    label = None
    while args and args[0] == "--label":
        if len(args) < 2:
            raise SystemExit("uat-lock: --label needs a value")
        label, args = args[1], args[2:]
    return label, args


def main(argv):
    if argv[:1] == ["status"]:
        return cmd_status()
    if argv[:1] == ["run"]:
        label, rest = parse_label(argv[1:])
        if rest and rest[0] == "--":
            rest = rest[1:]
        return cmd_run(label, rest)
    if argv[:1] == ["hold"]:
        label, rest = parse_label(argv[1:])
        if rest:
            say("usage: uat-lock hold [--label <text>]")
            return 2
        return cmd_hold(label)
    sys.stdout.write(__doc__)
    return 0 if argv[:1] in (["-h"], ["--help"]) else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
